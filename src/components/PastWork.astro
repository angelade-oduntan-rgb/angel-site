---
import SectionHeader from './SectionHeader.astro';

const experiences = [
  {
    icon: 'cap',
    company: 'UC Berkeley Haas',
    dates: 'Aug 2025 – present',
    role: 'MBA Candidate, Class of 2027',
    context: 'Haas School of Business · Business AI Foundations · Active member, Haas FinTech and Tech Clubs',
    bullets: [
      'Running an <strong class="text-navy font-semibold">International Business Development project</strong> with Claude as analytical copilot, advising a multinational identity and payments platform on <strong class="text-navy font-semibold">EU market entry</strong> under EUDI Digital Wallet and eIDAS 2.0.',
      'Building AI side projects: a <strong class="text-navy font-semibold">Payments Failure Diagnostic</strong>, a <strong class="text-navy font-semibold">Coffee Chat Prep Generator</strong>, and an <strong class="text-navy font-semibold">Operations Diagnosis Assistant</strong>.',
      '<strong class="text-navy font-semibold">International Student Representative (EMEA)</strong>, representing the African community at Haas.',
      '<strong class="text-navy font-semibold">Fall 2026 exchange semester</strong> at Columbia Business School (NYC).',
    ],
    tags: ['MBA', 'AI', 'IBD', 'NYC'],
  },
  {
    icon: 'building',
    company: 'Deloitte & Touche · Lagos, Nigeria',
    dates: 'Jul 2021 – Jul 2025',
    role: 'Senior Consultant',
    context: 'Risk Advisory practice · Financial Services, Public Sector, and Operations Transformation',
    bullets: [
      'Led <strong class="text-navy font-semibold">operations strategy</strong> and <strong class="text-navy font-semibold">revenue assurance</strong> engagements across payments, banking, public sector, and manufacturing. Diagnosed where systems were breaking, designed the controls, and shipped cross functional fixes with Product, Engineering, and Finance.',
      'Promoted <strong class="text-navy font-semibold">three times in four years</strong>, from Associate to Senior Consultant. Ran engagements at <strong class="text-navy font-semibold">$B+ scale</strong> and presented to CFO and board level audiences across <strong class="text-navy font-semibold">9 African markets</strong>.',
      'Recognized by Deloitte West Africa Risk Advisory with the <strong class="text-navy font-semibold">Quality Delivery award</strong> (December 2023). Built and led an internal upskilling program that trained <strong class="text-navy font-semibold">6+ associates</strong> and grew Volunteer Days participation <strong class="text-navy font-semibold">50%</strong>.',
    ],
    tags: ['Payments', 'Operating Model', 'Strategy', 'Cross-functional', 'Multi-country'],
  },
  {
    icon: 'bank',
    company: 'KPMG · Lagos, Nigeria',
    dates: 'Jun 2019 – May 2021',
    role: 'Consultant',
    context: 'Audit and Advisory · Financial Services practice',
    bullets: [
      '<strong class="text-navy font-semibold">Operational and advisory transformations</strong> across Nigeria\'s largest commercial banks: post-merger integration, branch operations, AML and compliance, and customer onboarding redesign.',
      'Led diagnostic walkthroughs across <strong class="text-navy font-semibold">50+</strong> bank locations and <strong class="text-navy font-semibold">366+</strong> branches for top-tier FS clients.',
    ],
    tags: ['Post-Merger', 'Banking', 'AML & Compliance'],
  },
];
---
<section id="past-work" class="py-20 sm:py-24">
  <div class="container-prose">
    <SectionHeader eyebrow="Experience" />
    <h2 class="section-title mt-8">Selected experience.</h2>

    <div class="mt-12 space-y-5">
      {experiences.map(({ icon, company, dates, role, context, bullets, tags }) => (
        <article class="rounded-3xl bg-card-featured border border-card-featured-border p-7 sm:p-10 shadow-card">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
            <!-- Left meta column -->
            <div class="lg:col-span-4">
              <div class="flex items-start gap-3">
                <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-teal-pale text-teal-deep shrink-0">
                  {icon === 'cap' && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 10v6" />
                      <path d="M2 10l10-5 10 5-10 5-10-5z" />
                      <path d="M6 12v5c0 1.5 2.5 3 6 3s6-1.5 6-3v-5" />
                    </svg>
                  )}
                  {icon === 'building' && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="4" y="2" width="16" height="20" rx="1" />
                      <path d="M9 6h.01M15 6h.01M9 10h.01M15 10h.01M9 14h.01M15 14h.01M10 18h4" />
                    </svg>
                  )}
                  {icon === 'bank' && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 21h18" />
                      <path d="M3 10h18" />
                      <path d="M3 7l9-4 9 4" />
                      <path d="M5 10v11" />
                      <path d="M19 10v11" />
                      <path d="M9 14v4" />
                      <path d="M15 14v4" />
                    </svg>
                  )}
                </div>
                <div class="min-w-0">
                  <p class="eyebrow leading-tight">{company}</p>
                  <p class="mt-1 text-sm text-body">{dates}</p>
                </div>
              </div>

              <div class="mt-6 flex flex-wrap gap-1.5">
                {tags.map((t) => (
                  <span class="inline-flex items-center rounded-full bg-teal-tag text-teal-deep px-2.5 py-0.5 text-[10px] font-semibold">
                    {t}
                  </span>
                ))}
              </div>
            </div>

            <!-- Right content column -->
            <div class="lg:col-span-8">
              <h3 class="font-serif font-bold text-navy text-xl sm:text-2xl leading-snug">{role}</h3>
              {context && (
                <p class="mt-2 italic text-muted text-sm sm:text-base leading-relaxed">{context}</p>
              )}

              <ul class="mt-6 space-y-3.5">
                {bullets.map((b) => (
                  <li class="flex gap-3 text-body leading-relaxed">
                    <span class="text-teal-deep font-semibold shrink-0 mt-0.5" aria-hidden="true">→</span>
                    <span class="text-sm sm:text-base" set:html={b}></span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
