---
import SectionHeader from './SectionHeader.astro';

const rows = [
  {
    label: 'Email',
    value: 'angel_ade-oduntan@berkeley.edu',
    href: 'mailto:angel_ade-oduntan@berkeley.edu',
    icon: 'mail',
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/angel-toki-adeoduntan',
    href: 'https://www.linkedin.com/in/angel-toki-adeoduntan',
    icon: 'linkedin',
  },
  {
    label: 'Website',
    value: 'angelade-oduntan.com',
    href: 'https://angelade-oduntan.com',
    icon: 'globe',
  },
  {
    label: 'Resume',
    value: 'Download PDF',
    href: '/cv.pdf',
    icon: 'file',
  },
];
---
<section id="contact" class="py-20 sm:py-24">
  <div class="container-prose">
    <SectionHeader eyebrow="Contact" />
    <h2 class="font-serif text-navy text-3xl sm:text-4xl lg:text-5xl leading-[1.1] mt-8">
      Let's <span class="italic text-teal">talk.</span>
    </h2>

    <p class="mt-6 text-body text-base sm:text-lg leading-relaxed">
      Interested in conversations about operations strategy, AI applied operations,
      business operations, payments operations, and the kind of operator problems where
      the right diagnosis matters more than the framework. Always happy to share notes
      or grab coffee.
    </p>

    <ul class="mt-12 space-y-3">
      {rows.map(({ label, value, href, icon }) => (
        <li>
          <a
            href={href}
            target={href.startsWith('http') ? '_blank' : undefined}
            rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="group flex items-center gap-4 sm:gap-6 px-4 sm:px-5 py-5 sm:py-6 bg-contact-row hover:bg-contact-hover transition-colors rounded-2xl shadow-card"
          >
            <span class="flex items-center justify-center w-9 h-9 rounded-full bg-teal-pale text-teal-deep shrink-0">
              {icon === 'mail' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m3 7 9 6 9-6" />
                </svg>
              )}
              {icon === 'linkedin' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
                </svg>
              )}
              {icon === 'globe' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
                </svg>
              )}
              {icon === 'file' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" />
                  <path d="M14 3v6h6" />
                </svg>
              )}
            </span>
            <div class="flex-1 min-w-0">
              <p class="eyebrow">{label}</p>
              <p class="mt-1 text-navy text-base sm:text-lg break-all">{value}</p>
            </div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-navy/40 group-hover:text-teal group-hover:translate-x-1 transition-all shrink-0"
            >
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-20 text-xs italic text-muted text-right">
      © 2026 Angel Ade-Oduntan · Built with Claude Code. Deployed with intention.
    </p>
  </div>
</section>
