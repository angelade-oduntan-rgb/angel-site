---
const navItems = [
  { label: 'About', href: '#hero' },
  { label: 'Featured Work', href: '#featured-work' },
  { label: 'Current Work', href: '#current-work' },
  /* TODO: re-enable Projects nav item once Projects section ships (target mid-June 2026)
  { label: 'Projects', href: '#projects' },
  */
  /* TODO: re-enable Writing nav item once first LinkedIn post is published (target mid-July 2026)
  { label: 'Writing', href: '#writing' },
  */
  { label: 'Experience', href: '#past-work' },
  { label: 'Case Studies', href: '#selected-work' },
  { label: 'Personal', href: '#personal' },
  { label: 'Contact', href: '#contact' },
];

const socials = [
  {
    label: 'Email',
    href: 'mailto:angel_ade-oduntan@berkeley.edu',
    icon: 'mail',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/angel-toki-adeoduntan',
    icon: 'linkedin',
  },
  /* TODO: re-enable GitHub link once profile has public repos worth showing recruiters
  {
    label: 'GitHub',
    href: 'https://github.com/angel-adeoduntan',
    icon: 'github',
  },
  */
];
---
<!-- Mobile top bar -->
<header class="lg:hidden fixed top-0 inset-x-0 z-40 h-16 bg-cream/95 backdrop-blur border-b border-teal/10 flex items-center justify-between px-5">
  <a href="#hero" class="font-serif text-navy text-lg">Angel Ade-Oduntan</a>
  <button
    id="nav-burger"
    type="button"
    aria-label="Open navigation"
    class="p-2 -mr-2 text-navy"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <line x1="4" y1="7" x2="20" y2="7" />
      <line x1="4" y1="12" x2="20" y2="12" />
      <line x1="4" y1="17" x2="20" y2="17" />
    </svg>
  </button>
</header>

<!-- Mobile drawer -->
<div
  id="nav-drawer"
  class="lg:hidden hidden fixed inset-0 z-50 bg-navy/40 transition-opacity duration-200 opacity-0"
  aria-hidden="true"
>
  <aside class="absolute left-0 top-0 bottom-0 w-72 max-w-[85vw] bg-cream shadow-xl flex flex-col">
    <div class="flex items-center justify-between p-5 border-b border-teal/10">
      <span class="font-serif text-navy text-lg">Menu</span>
      <button
        id="nav-close"
        type="button"
        aria-label="Close navigation"
        class="p-2 -mr-2 text-navy"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="18" y1="6" x2="6" y2="18" />
        </svg>
      </button>
    </div>
    <nav class="flex-1 p-6">
      <ul class="space-y-4">
        {navItems.map(({ label, href }) => (
          <li>
            <a
              href={href}
              data-nav-link-mobile
              class="block py-1 text-base text-navy hover:text-teal transition-colors"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="p-6 border-t border-teal/10 flex items-center gap-5">
      {socials.map((s) => (
        <a
          href={s.href}
          target={s.href.startsWith('http') ? '_blank' : undefined}
          rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          aria-label={s.label}
          class="text-navy hover:text-teal transition-colors"
        >
          {s.icon === 'mail' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          )}
          {s.icon === 'linkedin' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
            </svg>
          )}
          {s.icon === 'github' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.97.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.44-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15 0 1.55-.01 2.81-.01 3.19 0 .31.21.67.8.56C20.21 21.38 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z" />
            </svg>
          )}
        </a>
      ))}
    </div>
    <div class="px-6 pb-6">
      <a href="/cv.pdf" class="btn-outline w-full">Download Resume</a>
    </div>
  </aside>
</div>

<!-- Desktop sidebar -->
<aside class="hidden lg:flex fixed left-0 top-0 bottom-0 w-60 flex-col bg-cream border-r border-teal/10 px-7 py-10 z-30">
  <div>
    <a href="#hero" class="block">
      <img
        src="/angel.jpg?v=2"
        alt="Angel Ade-Oduntan"
        width="120"
        height="120"
        class="block w-[60px] h-[60px] mx-auto rounded-full object-cover ring-1 ring-teal/15 shadow-sm"
      />
      <h1 class="mt-5 font-serif text-navy text-2xl leading-tight">
        Angel<br />Ade-Oduntan
      </h1>
    </a>
    <p class="mt-3 eyebrow">AI Fluent Operator</p>
  </div>

  <nav class="mt-10 overflow-y-auto">
    <ul class="space-y-3">
      {navItems.map(({ label, href }) => (
        <li>
          <a
            href={href}
            data-nav-link
            data-active="false"
            class="group flex items-center gap-3 text-sm text-body hover:text-navy transition-colors data-[active=true]:text-navy"
          >
            <span
              class="inline-block w-1.5 h-1.5 rounded-full bg-teal opacity-0 group-data-[active=true]:opacity-100 transition-opacity"
              aria-hidden="true"
            />
            <span class="group-data-[active=true]:font-medium">{label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="mt-auto space-y-6">
    <div class="flex items-center gap-5">
      {socials.map((s) => (
        <a
          href={s.href}
          target={s.href.startsWith('http') ? '_blank' : undefined}
          rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          aria-label={s.label}
          class="text-navy hover:text-teal transition-colors"
        >
          {s.icon === 'mail' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          )}
          {s.icon === 'linkedin' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
            </svg>
          )}
          {s.icon === 'github' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.97.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.44-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15 0 1.55-.01 2.81-.01 3.19 0 .31.21.67.8.56C20.21 21.38 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z" />
            </svg>
          )}
        </a>
      ))}
    </div>
    <a href="/cv.pdf" class="btn-outline w-full text-xs px-4 py-2.5">Download Resume</a>
  </div>
</aside>
