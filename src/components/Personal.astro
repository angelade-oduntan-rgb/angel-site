---
import SectionHeader from './SectionHeader.astro';

const items = [
  {
    icon: 'palette',
    title: 'Abstract painting + sip-and-paint',
    body: 'Sip-and-paint nights with friends, plus quiet abstract work at home. The unstructured part is the part I like.',
  },
  {
    icon: 'museum',
    title: 'Museums and galleries',
    body: 'Visited so far: Nike Art Gallery (Lagos), BAMPFA, SFMoMA, the Louvre. Up next: MoMA and the Metropolitan Museum in New York.',
  },
  {
    icon: 'tennis',
    title: 'ATP tennis',
    body: 'Learned the sport during the pandemic. Long-time Djokovic fan, now following Alcaraz closely. Hard-court loyalist.',
  },
  {
    icon: 'dumbbell',
    title: 'Pilates and indoor cycling',
    body: 'Saturday Pilates is non-negotiable. Cycle Bar twice a week. The repetition does its own work.',
  },
  {
    icon: 'plane',
    title: 'Travel',
    body: 'Six African cities through work, plus New York and France. Planning a European tour next, an Asia tour after.',
  },
  {
    icon: 'globe',
    title: 'City exploration on YouTube',
    body: 'YouTube deep dives on cities I find fascinating: Brazil, Japan, and others I haven\'t been to yet. I like learning how a place works before I plan a trip.',
  },
];
---
<section id="personal" class="py-20 sm:py-24">
  <div class="container-prose">
    <SectionHeader eyebrow="Personal" />
    <h2 class="section-title mt-8">Outside the work.</h2>

    <div class="mt-14 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      {items.map(({ icon, title, body }) => (
        <article class="rounded-3xl bg-card-featured border border-card-featured-border p-7 shadow-card">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-teal-pale text-teal-deep">
            {icon === 'palette' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12c0 1.66 1.34 3 3 3h1a2 2 0 0 1 2 2v1a2 2 0 0 0 2 2h2z" />
                <circle cx="7.5" cy="10.5" r="1" />
                <circle cx="12" cy="7.5" r="1" />
                <circle cx="16.5" cy="10.5" r="1" />
              </svg>
            )}
            {icon === 'museum' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-5 9 5" />
                <path d="M4 9v10" />
                <path d="M20 9v10" />
                <path d="M8 9v10" />
                <path d="M12 9v10" />
                <path d="M16 9v10" />
                <path d="M3 21h18" />
              </svg>
            )}
            {icon === 'tennis' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <path d="M3.5 7.5C7 9 9 12 9 16.5" />
                <path d="M20.5 7.5C17 9 15 12 15 16.5" />
              </svg>
            )}
            {icon === 'dumbbell' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6.5 6.5 17.5 17.5" />
                <path d="m21 21-1.5-1.5" />
                <path d="M3 3l1.5 1.5" />
                <path d="m18 8 2-2-4-4-2 2" />
                <path d="m8 18-2 2-4-4 2-2" />
                <path d="m15 5 4 4" />
                <path d="m5 15 4 4" />
              </svg>
            )}
            {icon === 'plane' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z" />
              </svg>
            )}
            {icon === 'globe' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18" />
                <path d="M12 3a14 14 0 0 1 0 18" />
                <path d="M12 3a14 14 0 0 0 0 18" />
              </svg>
            )}
          </div>
          <h3 class="mt-5 font-serif font-bold text-navy text-lg sm:text-xl">{title}</h3>
          <p class="mt-2 text-sm text-body leading-relaxed">{body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
