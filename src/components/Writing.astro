---
import SectionHeader from './SectionHeader.astro';

const posts = [
  {
    label: 'LinkedIn · AI Workflows',
    title: 'Scoping an EU market entry as a Claude Project workflow',
    body: 'How I structured the IBD engagement as three parallel Claude sub-workflows: first pass competitive scans, vertical prioritization, and SKU level revenue modeling. The goal was to compress discovery and keep the judgment calls human.',
    cta: 'Coming October 2026',
  },
  {
    label: 'LinkedIn · Payments Operations',
    title: 'Six years finding leakage: an operator\'s framework',
    body: 'The diagnostic pattern I used to recover $1M in revenue leakage on a $170B-volume payments platform. Transaction lifecycle mapping, validation-control design, and why engineering pushback is almost always information you need.',
    cta: 'Coming October 2026',
  },
  {
    label: 'LinkedIn · Observations',
    title: 'Lagos operations: building for the degraded state',
    body: 'What growing up where the power grid goes out daily taught me about designing systems. Redundancy as a default mental model. Why I think this matters more, not less, in the AI era.',
    cta: 'Coming October 2026',
  },
];
---
<section id="writing" class="py-20 sm:py-24">
  <div class="container-prose">
    <SectionHeader eyebrow="Writing & Insights" />
    <p class="mt-8 max-w-3xl text-body text-base sm:text-lg leading-relaxed">
      Sometimes I write about payments operations, AI workflows, and what working in Lagos
      taught me about operating systems. More on LinkedIn.
    </p>

    <div class="mt-14 grid grid-cols-1 md:grid-cols-3 gap-6">
      {posts.map(({ label, title, body, cta }) => (
        <article class="flex flex-col rounded-3xl bg-card-featured border border-card-featured-border p-7 shadow-card hover:shadow-md transition-shadow">
          <p class="eyebrow">{label}</p>
          <h3 class="mt-4 font-serif font-bold text-navy text-lg sm:text-xl leading-snug">{title}</h3>
          <p class="mt-3 text-sm text-body leading-relaxed flex-1">{body}</p>
          <p class="mt-6 inline-flex items-center gap-1.5 text-sm italic font-medium text-teal-deep">
            {cta}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="not-italic">
              <path d="M7 17 17 7" />
              <path d="M7 7h10v10" />
            </svg>
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
